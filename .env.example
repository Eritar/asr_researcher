# Optional: everything here can also be set in the web UI (Settings), which takes precedence.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# OPENROUTER_PROVIDER=google-ai-studio   # one endpoint tag; empty = let OpenRouter route
# OPENROUTER_SORT=latency                # default; latency | throughput | price | "" (when no provider is pinned)
# OPENROUTER_FALLBACKS=true
# OPENROUTER_REASONING=off               # off | low | on  ("thinking" delays the first word by seconds)

# parakeet (default, fastest) | qwen3 (uses glossary.txt hotwords) | cohere (best WER, heavy) | canary (tiny)
# ASR_ENGINE=parakeet
# LANGUAGE=de          # required for cohere/canary; parakeet/qwen3 auto-detect en/de
# AUDIO_SOURCE=system  # or app:<macOS bundle id>, pulse:<source name>, file:/path/to/recording.wav
# NUM_THREADS=8
# VAD_MIN_SILENCE_S=0.35   # lower = faster finals, but sentences get split more
# SESSIONS_DIR=~/.local/share/call-assist/sessions   # where conversations are autosaved
